{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "eslint", "vitest", "node", "promise"],
  "env": {
    "builtin": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["**/.gitignore", "**/node_modules", "dist/**", ".context/**", "test.ts"],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "fix": {
          "imports": "safe-fix",
          "variables": "off"
        }
      }
    ],
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off", // Disabled because it's a common pattern in the codebase
    "no-array-constructor": "error",
    "prefer-arrow-callback": "error",
    "typescript/no-explicit-any": "off", // Disabled because it's a common pattern in the codebase
    "typescript/no-require-imports": "off", // Disabled because it's a common pattern in the codebase
    "typescript/no-unsafe-function-type": "error",
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/ban-ts-comment": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    // Bottleneck bridges promises to Node-style callbacks by design (the
    // submit()/schedule() dual API in src/Bottleneck.js).
    "promise/no-callback-in-promise": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "vitest/valid-describe-callback": "off",
    // Floating expect().resolves/.rejects assertions warn today and FAIL in
    // the next vitest major — they must be awaited, returned, or nested in an
    // awaited Promise.all. Stored-in-variable forms are also rejected.
    // NOTE: vitest plugin rules only recognize `expect` imported directly from
    // "vitest" — never re-export it through a helper module.
    "vitest/valid-expect": "error",
    // Our `test` comes from test/helpers/test-api.js (fixtures), which the
    // vitest plugin doesn't recognize as a test block — every expect() would
    // false-positive as "standalone".
    "vitest/no-standalone-expect": "off",
    // This suite deliberately asserts inside catch handlers and typed error
    // callbacks (e.g. counting expiration errors, asserting stop() reuse
    // rejections mid-chain); expect-expect still guarantees every test
    // asserts something.
    "vitest/no-conditional-expect": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expect.**",
          "expectTypeOf",
          "assert",
          "assertType",
          "assert.**"
        ]
      }
    ]
  }
}
