{
  "name": "@sderrow/bottleneck",
  "version": "4.0.0-rc.0",
  "description": "Distributed task scheduler and rate limiter",
  "keywords": [
    "async",
    "async rate limiter",
    "clustering",
    "limiter",
    "limiting",
    "load",
    "rate",
    "rate limiter",
    "rate limiting",
    "throttle",
    "throttler",
    "throttling"
  ],
  "bugs": {
    "url": "https://github.com/sderrow/bottleneck/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Simon Grondin"
  },
  "contributors": [
    {
      "name": "Sean Derrow"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sderrow/bottleneck.git"
  },
  "files": [
    "bottleneck.d.ts",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./bottleneck.d.ts",
      "default": "./dist/index.js"
    },
    "./light": {
      "types": "./bottleneck.d.ts",
      "default": "./dist/light.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:lib": "tsdown --filter lib",
    "build:light": "tsdown --filter light",
    "check-types": "tsc --noEmit --strict --ignoreConfig test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run check-types",
    "test": "mocha --timeout=10000 test",
    "test-all": "pnpm run test:ioredis && pnpm run test:redis && pnpm run test:light && pnpm test",
    "test:ioredis": "DATASTORE=ioredis pnpm test",
    "test:light": "BUILD=light pnpm test",
    "test:redis": "DATASTORE=redis pnpm test"
  },
  "devDependencies": {
    "@token-cjg/leakage": "^0.6.0",
    "@types/node": "^24.12.3",
    "husky": "^9.1.7",
    "ioredis": "^5.7.0",
    "lint-staged": "^16.1.5",
    "mocha": "^11.7.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "redis": "^2.8.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@11.0.8"
}
