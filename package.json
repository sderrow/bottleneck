{
  "name": "@sderrow/bottleneck",
  "version": "4.0.0-rc.0",
  "description": "Distributed task scheduler and rate limiter",
  "keywords": [
    "async",
    "async rate limiter",
    "clustering",
    "limiter",
    "limiting",
    "load",
    "rate",
    "rate limiter",
    "rate limiting",
    "throttle",
    "throttler",
    "throttling"
  ],
  "bugs": {
    "url": "https://github.com/sderrow/bottleneck/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Simon Grondin"
  },
  "contributors": [
    {
      "name": "Sean Derrow"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sderrow/bottleneck.git"
  },
  "files": [
    "bottleneck.d.ts",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./bottleneck.d.ts",
      "default": "./dist/index.js"
    },
    "./light": {
      "types": "./bottleneck.d.ts",
      "default": "./dist/light.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:lib": "tsdown --filter lib",
    "build:light": "tsdown --filter light",
    "check-types": "tsc --noEmit --strict --ignoreConfig test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run check-types",
    "test": "pnpm exec vitest",
    "test:cluster": "pnpm exec vitest run --project ioredis --project node-redis",
    "test:lib": "pnpm exec vitest run --project lib-smoke",
    "test:light": "pnpm exec vitest run --project light-smoke",
    "test:local": "pnpm exec vitest run --project local",
    "test:memory": "pnpm exec vitest run --project memory",
    "test:smoke": "pnpm exec vitest run --project light-smoke --project lib-smoke"
  },
  "devDependencies": {
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^24.12.3",
    "husky": "^9.1.7",
    "ioredis": "^5.7.0",
    "lint-staged": "^16.1.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "redis": "^5.0.0",
    "testcontainers": "^11.14.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "ioredis": "^5",
    "redis": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
