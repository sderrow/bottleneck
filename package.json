{
  "name": "@sderrow/bottleneck",
  "version": "4.0.0-rc.0",
  "description": "Distributed task scheduler and rate limiter",
  "keywords": [
    "async",
    "async rate limiter",
    "clustering",
    "limiter",
    "limiting",
    "load",
    "rate",
    "rate limiter",
    "rate limiting",
    "throttle",
    "throttler",
    "throttling"
  ],
  "bugs": {
    "url": "https://github.com/sderrow/bottleneck/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Simon Grondin"
  },
  "contributors": [
    {
      "name": "Sean Derrow"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sderrow/bottleneck.git"
  },
  "files": [
    "bottleneck.d.ts",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./bottleneck.d.ts",
      "default": "./dist/index.js"
    },
    "./light": {
      "types": "./bottleneck.d.ts",
      "default": "./dist/light.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:lib": "tsdown --filter lib",
    "build:light": "tsdown --filter light",
    "check-types": "tsc --noEmit --strict --ignoreConfig test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run check-types",
    "test": "pnpm exec vitest",
    "test:cluster": "pnpm exec vitest run --project ioredis --project node-redis",
    "test:lib": "pnpm exec vitest run --project lib-smoke",
    "test:light": "pnpm exec vitest run --project light-smoke",
    "test:local": "pnpm exec vitest run --project local",
    "test:memory": "pnpm exec vitest run --project memory",
    "test:smoke": "pnpm exec vitest run --project light-smoke --project lib-smoke"
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.0.4",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "ioredis": "^5.11.1",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "redis": "^6.1.0",
    "testcontainers": "^12.0.4",
    "tsdown": "^0.22.4",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "ioredis": "^5",
    "redis": "^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
